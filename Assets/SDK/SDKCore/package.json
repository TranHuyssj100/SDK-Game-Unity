{
    "name": "com.lsdk.core",
    "displayName": "LSDK Core",
    "version": "1.1.0",
    "unity": "2022.3",
    "description": "LSDK Core gộp Base, Observer, ObjectPools, GameData, UISystem, Loading, IAP và GameManager. Mỗi module giữ assembly riêng.",
    "dependencies": {
        "com.unity.purchasing": "5.4.3",
        "com.unity.services.core": "1.12.5",
        "com.unity.ugui": "1.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TranHuyssj100/SDK-Game-Unity.git",
        "directory": "Assets/SDK/SDKCore"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/@tranhuyssj100"
    },
    "files": [
        "Base",
        "Base.meta",
        "Observer",
        "Observer.meta",
        "ObjectPools",
        "ObjectPools.meta",
        "GameData",
        "GameData.meta",
        "UISystem",
        "UISystem.meta",
        "Loading",
        "Loading.meta",
        "IAP.meta",
        "IAP/Editor",
        "IAP/Editor.meta",
        "IAP/Runtime",
        "IAP/Runtime.meta",
        "IAP/Samples~",
        "IAP/README.md",
        "IAP/README.md.meta",
        "README.md",
        "README.md.meta",
        "CHANGELOG.md",
        "CHANGELOG.md.meta",
        "Runtime",
        "Runtime.meta",
        "Editor",
        "Editor.meta",
        "GameManager",
        "GameManager.meta"
    ],
    "samples": [
        {
            "displayName": "GameData Default Modules",
            "description": "Player, Currency, Inventory, Settings, Gameplay. Import vào Assets để sửa. Mọi class kế thừa GameDataModule được tự đăng ký.",
            "path": "GameData/Samples~/DefaultModules"
        },
        {
            "displayName": "IAP GameData Integration",
            "description": "GameDataRewardGranter + IAPRewardType hằng số (Coin, Gem, ...). Cần import Default Modules của GameData.",
            "path": "IAP/Samples~/GameDataIntegration"
        },
        {
            "displayName": "IAP Button",
            "description": "Ví dụ UI Button gọi IAPManager.Purchase.",
            "path": "IAP/Samples~/IAPButton"
        }
    ],
